# ── Stage 1: Build the Angular app ────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first (Docker cache optimization)
COPY angular-frontend/package*.json ./

# Install Node dependencies
RUN npm install

# Copy the rest of the Angular source
COPY angular-frontend/ .

# Build for production
RUN npm run build

# ── Stage 2: Serve with Nginx ─────────────────────────────────────────────────
FROM nginx:alpine

# Copy the built Angular files into Nginx's serve folder
COPY --from=builder /app/dist/log-analyzer-frontend/browser /usr/share/nginx/html

# Copy our custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80